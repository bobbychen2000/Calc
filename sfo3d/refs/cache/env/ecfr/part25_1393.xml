</TR>
</THEAD>
<TBODY>
<TR>
<TD class="left border-right-single">0°</TD>
<TD class="right">1.00</TD>
</TR>
<TR>
<TD class="left border-right-single">0° to 5°</TD>
<TD class="right">0.90</TD>
</TR>
<TR>
<TD class="left border-right-single">5° to 10°</TD>
<TD class="right">0.80</TD>
</TR>
<TR>
