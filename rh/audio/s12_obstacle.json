 "chunks": [
  {
   "text": "Stepanov detects multiplicity with derivatives: at a double root,",
   "start": 0.7,
   "end": 4.888
  },
  {
   "text": "f and its slope both vanish.",
   "start": 4.888,
   "end": 7.263
  },
  {
   "text": "Alpöge calls his argument a descendant of Stepanov's,",
   "start": 7.263,
   "end": 10.6
  },
  {
   "text": "but writes that multiplicity is hard to find over the integers,",
   "start": 10.6,
   "end": 14.188
  },
  {
   "text": "corresponding to something like differentiating whole numbers.",
   "start": 14.188,
   "end": 17.8
  },
  {
   "text": "Still, root counting has an old integer cousin.",
   "start": 18.75,
   "end": 21.787
  },
  {
   "text": "A whole number that isn't zero, but is divisible by many primes,",
   "start": 21.787,
   "end": 25.175
  },
  {
   "text": "must be large.",
   "start": 25.175,
   "end": 26.562
  },
  {
   "text": "Twenty choose ten is divisible by every prime between ten and twenty,",
   "start": 26.562,
   "end": 30.65
  },
  {
   "text": "yet it's less than four to the tenth, so those primes can't be too many.",
   "start": 30.65,
   "end": 35.087
  },
  {
   "text": "Each prime factor plays the role of a root, its power the role of multiplicity,",
   "start": 35.087,
   "end": 39.812
  },
  {
   "text": "and size, on a log scale, the role of degree.",
   "start": 39.812,
   "end": 43.112
  },
  {
   "text": "Around 1850, Chebyshev used this idea, with ratios of factorials,",
   "start": 43.575,
   "end": 48.475
  },
  {
   "text": "to bound the primes, but only roughly: those numbers aren't divisible enough.",
   "start": 48.475,
   "end": 53.35
  }
 ],
 "cues": {
  "quote": 7.263,
  "cousin": 18.75,
  "binom": 26.562,
  "dict": 35.087,
  "cheb": 43.575
 }
}