 "chunks": [
  {
   "text": "The argument is not short.",
   "start": 0.7,
   "end": 2.738
  },
  {
   "text": "Alpöge's timeline runs from October sixth to November sixteenth,",
   "start": 2.738,
   "end": 6.888
  },
  {
   "text": "through much of modern number theory.",
   "start": 6.888,
   "end": 9.188
  },
  {
   "text": "The result is a Lean library of 175,187 files and",
   "start": 9.188,
   "end": 13.712
  },
  {
   "text": "17.4 million lines, without a single comment.",
   "start": 13.712,
   "end": 17.775
  },
  {
   "text": "Read from the top, its skeleton is short.",
   "start": 18.75,
   "end": 21.262
  },
  {
   "text": "Last step: no zeros to the right of one half, plus the mirror symmetry,",
   "start": 21.262,
   "end": 25.0
  },
  {
   "text": "gives the Riemann Hypothesis.",
   "start": 25.0,
   "end": 26.8
  },
  {
   "text": "Before that: if a weighted prime sum stays below about root x,",
   "start": 26.8,
   "end": 30.6
  },
  {
   "text": "there can be no zeros to the right of one half,",
   "start": 30.6,
   "end": 32.75
  },
  {
   "text": "for zeta and for every Dirichlet L-function.",
   "start": 32.75,
   "end": 35.65
  },
  {
   "text": "And the enormous middle, built from theta lifts, Galois representations,",
   "start": 35.65,
   "end": 39.625
  },
  {
   "text": "and tools from the Langlands program, proves that bound,",
   "start": 39.625,
   "end": 42.975
  },
  {
   "text": "with chains of length at least x to the one half minus epsilon.",
   "start": 42.975,
   "end": 46.487
  },
  {
   "text": "Readers also report that a few steps in the note's timeline have no visible",
   "start": 46.975,
   "end": 51.25
  },
  {
   "text": "counterpart in the code.",
   "start": 51.25,
   "end": 52.85
  }
 ],
 "cues": {
