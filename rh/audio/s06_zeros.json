 "chunks": [
  {
   "text": "Some zeros are easy: minus two, minus four, minus six,",
   "start": 0.75,
   "end": 4.475
  },
  {
   "text": "and so on, the trivial zeros.",
   "start": 4.475,
   "end": 6.963
  },
  {
   "text": "Every other zero lies in a narrow band, the critical strip,",
   "start": 6.963,
   "end": 10.45
  },
  {
   "text": "where sigma is between zero and one.",
   "start": 10.45,
   "end": 13.05
  },
  {
   "text": "A functional equation ties zeta at s to zeta at one minus s,",
   "start": 13.975,
   "end": 18.2
  },
  {
   "text": "so the zeros are mirrored across the middle of the strip:",
   "start": 18.2,
   "end": 21.075
  },
  {
   "text": "the critical line, real part one half.",
   "start": 21.075,
   "end": 24.062
  },
  {
   "text": "The first zero above the axis sits at one half,",
   "start": 24.062,
   "end": 27.025
  },
  {
   "text": "plus fourteen point one three four seven i.",
   "start": 27.025,
   "end": 29.925
  }
 ],
